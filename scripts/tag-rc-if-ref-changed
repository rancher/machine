#!/usr/bin/env bash
set -euo pipefail

base_pattern="${1:?Usage: $0 <base-pattern> [remote] [branch]}"
remote="${2:-origin}"
branch="${3:-master}"
supported_tag_pattern="^${base_pattern}[0-9]+(-rc\.[0-9]+)?$"
base_tag_pattern="^${base_pattern}"

git check-ref-format --branch "$branch" >/dev/null
git fetch --quiet --tags "$remote" "refs/heads/$branch:refs/remotes/$remote/$branch"

target="refs/remotes/$remote/$branch"
target_commit="$(git rev-parse "${target}^{commit}")"
latest="$(
  git tag --list --sort=version:refname |
    grep -E "$supported_tag_pattern" |
    tail -n1 || true
)"

if [[ -z "$latest" ]]; then
  if git tag --list | grep -E "$base_tag_pattern" >/dev/null; then
    echo "Tags matching $base_pattern found, but none match the supported format" >&2
  else
    echo "No tags matching $base_pattern found" >&2
  fi
  exit 1
fi

latest_commit="$(git rev-parse "${latest}^{commit}")"
if [[ "$latest_commit" == "$target_commit" ]]; then
  echo "$branch is unchanged since $latest"
  exit 0
fi

if [[ "$latest" =~ -rc\.([0-9]+)$ ]]; then
  next="${latest%-rc.*}-rc.$((BASH_REMATCH[1] + 1))"
elif [[ "$latest" =~ ([0-9]+)$ ]]; then
  number="${BASH_REMATCH[1]}"
  next="${latest%"$number"}$((number + 1))-rc.0"
else
  echo "Unexpected tag: $latest" >&2
  exit 1
fi

if git ls-remote --exit-code --tags "$remote" "refs/tags/$next" >/dev/null 2>&1; then
  echo "Tag already exists: $next" >&2
  exit 1
fi

echo "Latest tag:  $latest"
echo "$branch commit: $target_commit"
echo "Next tag:    $next"

git tag --no-sign -a "$next" "$target_commit" -m "Release candidate $next"
