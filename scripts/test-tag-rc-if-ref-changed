#!/usr/bin/env bash
set -euo pipefail

# Functional tests for scripts/tag-rc-if-ref-changed.
#
# Each case builds a throwaway "source" repo (the origin the script fetches
# from) and a "runner" clone (where the script creates tags), arranges
# tags/commits, runs the script, and asserts on the exit code, output, and
# resulting tags. Override the script under test with the SCRIPT_UNDER_TEST
# environment variable.

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
tagger="${SCRIPT_UNDER_TEST:-$repo_root/scripts/tag-rc-if-ref-changed}"
base_pattern='v0.15.0-rancher'
tmpdir="$(mktemp -d)"
source_repo="$tmpdir/source"
runner_repo="$tmpdir/runner"

trap 'rm -rf "$tmpdir"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

setup_repo() {
  local tag="$1"

  rm -rf "$source_repo" "$runner_repo"
  git init --quiet -b master "$source_repo"
  git -C "$source_repo" config user.name tester
  git -C "$source_repo" config user.email tester@example.com
  git -C "$source_repo" config commit.gpgSign false
  printf 'initial\n' > "$source_repo/README"
  git -C "$source_repo" add README
  git -C "$source_repo" commit --quiet -m initial
  git -C "$source_repo" tag --no-sign -a "$tag" -m "$tag"

  git clone --quiet "$source_repo" "$runner_repo"
  git -C "$runner_repo" config user.name tester
  git -C "$runner_repo" config user.email tester@example.com
}

tag_source() {
  local tag="$1"

  git -C "$source_repo" tag --no-sign -a "$tag" -m "$tag"
}

commit_to_branch() {
  local message="$1"

  printf '%s\n' "$message" >> "$source_repo/README"
  git -C "$source_repo" commit --quiet -am "$message"
}

run_tagger() {
  (
    cd "$runner_repo"
    "$tagger" "${1:-$base_pattern}" "${2:-origin}" "${3:-master}"
  )
}

assert_tag() {
  local tag="$1"

  test "$(git -C "$runner_repo" tag --list "$tag")" = "$tag" ||
    fail "missing tag $tag"
}

assert_tag_points_to_ref() {
  local tag="$1"
  local ref="${2:-master}"
  local tag_commit
  local ref_commit

  tag_commit="$(git -C "$runner_repo" rev-parse "${tag}^{commit}")"
  ref_commit="$(git -C "$source_repo" rev-parse "$ref")"
  test "$tag_commit" = "$ref_commit" ||
    fail "$tag does not point to $ref"
}

setup_repo v0.15.0-rancher149
if (
  cd "$runner_repo"
  "$tagger"
) >"$tmpdir/missing-base-pattern-output" 2>&1; then
  fail "accepted a missing base pattern"
fi
grep -q 'Usage: .* <base-pattern>' "$tmpdir/missing-base-pattern-output" ||
  fail "missing base pattern did not report usage"

run_tagger
test -z "$(git -C "$source_repo" tag --list 'v0.15.0-rancher150-rc.*')" ||
  fail "created a tag for an unchanged ref"

commit_to_branch first-change
run_tagger
assert_tag v0.15.0-rancher150-rc.0
assert_tag_points_to_ref v0.15.0-rancher150-rc.0

commit_to_branch second-change
run_tagger
assert_tag v0.15.0-rancher150-rc.1
assert_tag_points_to_ref v0.15.0-rancher150-rc.1

run_tagger
test "$(git -C "$runner_repo" tag --list 'v0.15.0-rancher150-rc.*' | wc -l)" -eq 2 ||
  fail "created a duplicate tag for an unchanged ref"

setup_repo v0.15.0-rancher150.1
if run_tagger >"$tmpdir/dotted-tag-output" 2>&1; then
  fail "accepted unsupported dotted tag"
fi
grep -q 'Tags matching v0.15.0-rancher found, but none match the supported format' "$tmpdir/dotted-tag-output" ||
  fail "dotted tag did not report its unsupported format"

# No tags match the base pattern at all.
setup_repo v9.9.9-unrelated
commit_to_branch change
if run_tagger 'v0\.15\.0-rancher145\.' >"$tmpdir/no-tags-output" 2>&1; then
  fail "succeeded when no tags matched the base pattern"
fi
grep -q 'No tags matching' "$tmpdir/no-tags-output" ||
  fail "did not report that no tags match the base pattern"

# Regression test: a final release tag promoted from an rc sorts before its
# own rc tags under version sort, so the rc tags must not be selected over
# the final tag. The next tag must bump the version and reset the rc counter
# instead of incrementing the rc of the superseded rc tag.
setup_repo v0.15.0-rancher145.1
for rc in 0 1 2; do
  tag_source "v0.15.0-rancher145.1-rc.$rc"
done
commit_to_branch release
tag_source v0.15.0-rancher145.2-rc.0
tag_source v0.15.0-rancher145.2 # promoted final release, same commit as rc.0
commit_to_branch post-release
run_tagger 'v0\.15\.0-rancher145\.'
assert_tag v0.15.0-rancher145.3-rc.0
assert_tag_points_to_ref v0.15.0-rancher145.3-rc.0
test -z "$(git -C "$runner_repo" tag --list 'v0.15.0-rancher145.2-rc.1')" ||
  fail "incremented the rc of a tag superseded by a final release"

# Same promotion scenario, with several rc's cut across commits before the
# final release is tagged: after v0.15.0-rancher150.0-rc.0 and -rc.1 are cut
# and v0.15.0-rancher150.0 is released, the next tag must bump the patch
# version and reset the rc counter.
setup_repo v0.15.0-rancher149.9
commit_to_branch change-one
tag_source v0.15.0-rancher150.0-rc.0
commit_to_branch change-two
tag_source v0.15.0-rancher150.0-rc.1
tag_source v0.15.0-rancher150.0 # final release, promoted from rc.1
commit_to_branch change-three
run_tagger 'v0\.15\.0-rancher150\.'
assert_tag v0.15.0-rancher150.1-rc.0
assert_tag_points_to_ref v0.15.0-rancher150.1-rc.0
test -z "$(git -C "$runner_repo" tag --list 'v0.15.0-rancher150.0-rc.2')" ||
  fail "incremented the rc of v0.15.0-rancher150.0 instead of bumping to 150.1-rc.0"

# rc tags must be compared numerically: rc.10 is greater than rc.9.
setup_repo v0.15.0-rancher145.1
commit_to_branch change-one
tag_source v0.15.0-rancher145.2-rc.9
commit_to_branch change-two
tag_source v0.15.0-rancher145.2-rc.10
commit_to_branch change-three
run_tagger 'v0\.15\.0-rancher145\.'
assert_tag v0.15.0-rancher145.2-rc.11
assert_tag_points_to_ref v0.15.0-rancher145.2-rc.11

# A branch that has not moved since a final release was promoted from an rc
# must be left alone.
setup_repo v0.15.0-rancher145.1
commit_to_branch release
tag_source v0.15.0-rancher145.2-rc.0
tag_source v0.15.0-rancher145.2
run_tagger 'v0\.15\.0-rancher145\.'
test -z "$(git -C "$runner_repo" tag --list 'v0.15.0-rancher145.3-rc.*')" ||
  fail "created a tag for an unchanged ref with a promoted final release"

for branch_series in \
  "release/v2.15 v0.15.0-rancher145." \
  "release/v2.14 v0.15.0-rancher142." \
  "release/v2.13 v0.15.0-rancher137."; do
  read -r branch series <<<"$branch_series"
  base_pattern="${series//./\\.}"
  setup_repo "${series}1-rc.0"
  git -C "$source_repo" branch -m master "$branch"
  git -C "$runner_repo" branch -m master "$branch"
  run_tagger "$base_pattern" origin "$branch"

  commit_to_branch "$branch-change"
  run_tagger "$base_pattern" origin "$branch"
  assert_tag "${series}1-rc.1"
  assert_tag_points_to_ref "${series}1-rc.1" "$branch"
  test "$(git -C "$runner_repo" tag --list "${series}1-rc.*" | wc -l)" -eq 2 ||
    fail "created an unexpected tag for $branch"

  run_tagger "$base_pattern" origin "$branch"
done

echo "tag-rc-if-ref-changed tests passed"
